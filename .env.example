# Copy to .env and fill in. Never commit .env. Restart the app after changes.

# Required
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/anlima?sslmode=require
# The site's public address: http://localhost:3000 locally, https://anlimacarrental.com live.
BETTER_AUTH_URL=http://localhost:3000
# Random secret of at least 32 characters. Changing it signs everyone out.
BETTER_AUTH_SECRET=

# Optional dedicated key for encrypting Ghana Card numbers (32+ characters).
# Keep it stable. If blank, encryption uses a key derived from BETTER_AUTH_SECRET.
IDENTITY_ENCRYPTION_SECRET=

# Payments: start with test credentials.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# Must match the Secret Hash in Flutterwave's v3 webhook settings.
FLUTTERWAVE_WEBHOOK_SECRET=
# Webhooks on your public HTTPS domain:
# /api/webhooks/paystack
# /api/webhooks/flutterwave

# Email (Resend). The EMAIL_FROM domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=ANLIMA Car Rental <bookings@anlimacarrental.com>
EMAIL_REPLY_TO=
# ANLIMA inbox that receives staff alerts.
OPERATIONS_EMAIL=

# SMS (SMSOnlineGH). The sender name must be approved in the account.
SMSONLINEGH_API_KEY=
SMSONLINEGH_SENDER=

# Reminders and retries: GET /api/cron/notifications every 10-15 minutes with
# "Authorization: Bearer <CRON_SECRET>". At least 16 random characters.
CRON_SECRET=

# Fleet tracking (Tracksolid Pro). See docs/gps-tracksolid.md.
TRACKSOLID_APP_KEY=
TRACKSOLID_APP_SECRET=
TRACKSOLID_ACCOUNT=
TRACKSOLID_PASSWORD_MD5=
TRACKSOLID_NODE=eu

# Chat assistant (Claude). See docs/assistant.md.
ANTHROPIC_API_KEY=
# Optional: most assistant replies per day across all visitors.
ASSISTANT_DAILY_LIMIT=

# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Callback: <BETTER_AUTH_URL>/api/auth/callback/google

# Optional Meta/Facebook sign-in
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Callback: <BETTER_AUTH_URL>/api/auth/callback/facebook
