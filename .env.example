# Required
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/anlima?sslmode=require
BETTER_AUTH_URL=http://localhost:3000
# Generate a random secret of at least 32 characters.
BETTER_AUTH_SECRET=

# Optional dedicated key for encrypting Ghana Card numbers (32+ characters).
# Keep it stable. If blank, encryption uses a key derived from BETTER_AUTH_SECRET.
IDENTITY_ENCRYPTION_SECRET=

# Payments: start with test credentials. Restart the app after changing keys.
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
# Must match the Secret Hash in Flutterwave's v3 webhook settings.
FLUTTERWAVE_WEBHOOK_SECRET=
# Webhooks on your public HTTPS domain:
# /api/webhooks/paystack
# /api/webhooks/flutterwave
# Hosted checkout does not need public payment keys.

# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local callback: http://localhost:3000/api/auth/callback/google

# Optional Meta/Facebook sign-in
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Local callback: http://localhost:3000/api/auth/callback/facebook
# Use the same callback paths on your HTTPS app domain when deploying.
