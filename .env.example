DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
PAYSTACK_SECRET_KEY=
# Optional dedicated secret (32+ characters) for Ghana Card encryption.
# If omitted, a domain-separated key is derived from BETTER_AUTH_SECRET.
# Keep this secret stable so existing identity records remain readable.
IDENTITY_ENCRYPTION_SECRET=

# Social sign-in. Keep secrets server-side. Restart the app after setting these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Register these redirect URLs with the providers for local development:
# http://localhost:3000/api/auth/callback/google
# http://localhost:3000/api/auth/callback/facebook
# Use your production BETTER_AUTH_URL with the same paths when deploying.
